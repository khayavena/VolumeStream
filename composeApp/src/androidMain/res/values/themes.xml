<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme (used after splash dismisses) -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen theme: plain black — Compose splash handles the visuals -->
    <style name="Theme.VolumeStream.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <!-- Transparent icon overrides the default launcher icon so nothing shows -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
    <!-- Android TV theme: must not be a "Light" theme; TV expects a dark base -->
    <style name="Theme.VolumeStream.Tv" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
    </style>

</resources>
